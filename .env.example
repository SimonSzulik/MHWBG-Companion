# Supabase – aus dem Dashboard: Project Settings → API
# Diese Werte sind clientseitig (public). Der echte Schutz läuft über RLS.
# Kopiere diese Datei zu .env.local und trage deine Werte ein.
# Project URL from Dashboard → Settings → API ("Project URL"), NOT the /rest/v1 path
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=DEIN-ANON-PUBLIC-KEY
