{
  "name": "mhwbg-companion",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Companion / Kampagnen-Tracker PWA für Monster Hunter World: The Board Game",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test:calendar": "npx tsx src/domain/calendar.test.ts",
    "test:domain": "npx tsx src/domain/calendar.test.ts && npx tsx src/domain/trade.test.ts && npx tsx src/domain/quests.test.ts && npx tsx src/domain/questRewards.test.ts && npx tsx src/domain/catalog.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.16.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
